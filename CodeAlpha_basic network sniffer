      "source": [
        "!pip install scapy\n",
        "from scapy.all import sniff, IP, TCP, UDP, ICMP, Raw\n",
        "\n",
        "print(\"=\" * 60)\n",
        "print(\"       NETWORK PACKET CAPTURE PROGRAM\")\n",
        "print(\"=\" * 60)\n",
        "print(\"Capturing 10 packets...\")\n",
        "print(\"Please browse some websites while capturing.\\n\")\n",
        "\n",
        "\n",
        "def analyze_packet(packet):\n",
        "    if IP in packet:\n",
        "\n",
        "        source_ip = packet[IP].src\n",
        "        destination_ip = packet[IP].dst\n",
        "\n",
        "        # Identify protocol\n",
        "        if TCP in packet:\n",
        "            protocol = \"TCP\"\n",
        "        elif UDP in packet:\n",
        "            protocol = \"UDP\"\n",
        "        elif ICMP in packet:\n",
        "            protocol = \"ICMP\"\n",
        "        else:\n",
        "            protocol = \"Other\"\n",
        "\n",
        "        print(\"-\" * 60)\n",
        "        print(\"Source IP      :\", source_ip)\n",
        "        print(\"Destination IP :\", destination_ip)\n",
        "        print(\"Protocol       :\", protocol)\n",
        "\n",
        "        # Display payload\n",
        "        if Raw in packet:\n",
        "            payload = bytes(packet[Raw].load)\n",
        "            print(\"Payload        :\", payload[:100])\n",
        "        else:\n",
        "            print(\"Payload        : No payload\")\n",
        "\n",
        "\n",
        "# Capture 10 packets\n",
        "sniff(prn=analyze_packet, count=10)\n",
        "\n",
        "print(\"\\n\" + \"=\" * 60)\n",
        "print(\"Packet capture completed!\")\n",
        "print(\"=\" * 60)"
      ],
