        "\n",
        "    if IP in packet:\n",
        "        count += 1\n",
        "\n",
        "        if TCP in packet:\n",
        "            protocol = \"TCP\"\n",
        "        elif UDP in packet:\n",
        "            protocol = \"UDP\"\n",
        "        elif ICMP in packet:\n",
        "            protocol = \"ICMP\"\n",
        "        else:\n",
        "            protocol = \"Other\"\n",
        "\n",
        "        print(\"-\" * 60)\n",
        "        print(\"Packet Number  :\", count)\n",
        "        print(\"Source IP      :\", packet[IP].src)\n",
        "        print(\"Destination IP :\", packet[IP].dst)\n",
        "        print(\"Protocol       :\", protocol)\n",
        "\n",
        "        if Raw in packet:\n",
        "            print(\"Payload        :\", bytes(packet[Raw].load)[:100])\n",
        "        else:\n",
        "            print(\"Payload        : No payload\")\n",
        "\n",
